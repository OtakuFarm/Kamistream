{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/ads.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/latest-episodes",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=1800, stale-while-revalidate=3600" },
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/sitemap-static.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap-media.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "$comment": "vercel.json notes. The three retired sitemap 301s below exist because those files were removed when the sitemap was rebuilt on the manifest in src/lib/routes.js. Without an explicit redirect they fall through the catch-all rewrite to /index.html and answer 200 text/html - a soft 404, which is worse than a real 404 because a crawler believes it succeeded. /sitemap.xml was the old hand-maintained list and now points at the index; /sitemap-anime.xml became /sitemap-media.xml; /sitemap-pages.xml became /sitemap-static.xml.",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "kamistream.fun" }],
      "destination": "https://www.kamistream.fun/$1",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-anime.xml",
      "destination": "/sitemap-media.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/sitemap-static.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt",        "destination": "/robots.txt" },
    { "source": "/manifest.json",     "destination": "/manifest.json" },
    { "source": "/ads.js",            "destination": "/ads.js" },
    { "source": "/sw.js",             "destination": "/sw.js" },
    { "source": "/latest-episodes",   "destination": "/api/latest" },
    { "source": "/latest-episodes/",  "destination": "/api/latest" },
    { "source": "/assets/(.*)",       "destination": "/api/asset-404" },
    { "source": "/(.*)",              "destination": "/index.html" }
  ]
}
